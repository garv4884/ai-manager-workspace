# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could determine what is on screen and what gets clicked on when captured.
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Crash Report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro generated files
[Aa]ssets/[Tt]ext[Mm]esh*[Pp]ro/[Rr]esources/[Ff]onts & [Mm]aterials/

# Annotation Coverage
/[Aa]ssets/[Ss]cripts/[Ee]ditor/[Cc]overage*

# IDE files
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Rider
.idea/

# Gradle
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/mainTemplate.gradle.meta
*.gradle

# AI Manager: API keys never go into git or the APK (see Tools > AI Manager > Quest API Key)
/[Aa]ssets/[Ss]treaming[Aa]ssets/config.json
/[Aa]ssets/[Ss]treaming[Aa]ssets/config.json.meta
